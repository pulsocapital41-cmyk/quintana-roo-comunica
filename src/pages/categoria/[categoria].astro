---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';

export async function getStaticPaths() {
  const categories = [
    { slug: 'estatales', label: 'Estatales', desc: 'Noticias de los municipios de Quintana Roo: seguridad, gobierno, deportes y vida comunitaria.' },
    { slug: 'turismo', label: 'Turismo', desc: 'Destinos, playas, cenotes y experiencias del Caribe mexicano.' },
    { slug: 'cultura', label: 'Cultura', desc: 'Tradiciones, gastronomía, arte y identidad de la península.' },
    { slug: 'medio-ambiente', label: 'Medio ambiente', desc: 'Selva, arrecifes, manglares y fauna: el patrimonio natural de Quintana Roo.' },
    { slug: 'historia', label: 'Historia', desc: 'Cultura maya, leyendas, piratas y los orígenes del Caribe mexicano.' },
    { slug: 'opinion', label: 'Opinión', desc: 'Análisis, reportajes y voces del Caribe.' },
  ];

  const allNoticias = await getCollection('noticias');

  return categories.map((cat) => {
    const filtered = allNoticias
      .filter((n) => n.data.category === cat.label)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { categoria: cat.slug },
      props: {
        categoryLabel: cat.label,
        categoryDesc: cat.desc,
        articles: filtered,
      },
    };
  });
}

const { categoryLabel, categoryDesc, articles } = Astro.props;
---

<BaseLayout
  title={`${categoryLabel} | Quintana Roo Comunica`}
  description={categoryDesc}
  currentCategory={categoryLabel}
>
  <div class="container-editorial category-page">
    <header class="category-banner">
      <span class="badge-category">{categoryLabel}</span>
      <h1 class="category-main-title">{categoryLabel}</h1>
      <p class="category-description">{categoryDesc}</p>
    </header>

    {articles.length === 0 ? (
      <div class="empty-state">
        <p>Aún no hay notas publicadas en esta sección.</p>
      </div>
    ) : (
      <div class="category-articles-grid">
        {articles.map((article, index) => (
          <NewsCard article={article} variant="default" isLcp={index === 0} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .category-page {
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  .category-banner {
    border-top: 4px solid var(--color-qroo-navy);
    border-bottom: 1px solid var(--color-qroo-border);
    padding: 1.5rem 0;
    margin-bottom: 2.25rem;
    position: relative;
  }

  .category-banner::before {
    content: "";
    position: absolute;
    top: -4px;
    left: 0;
    width: 90px;
    height: 4px;
    background-color: var(--color-qroo-cyan);
  }

  .category-main-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--color-qroo-navy);
    margin: 0.25rem 0 0.5rem 0;
    line-height: 1.1;
  }

  .category-description {
    font-size: 1.05rem;
    color: var(--color-qroo-slate);
    margin: 0;
    max-width: 65ch;
  }

  .category-articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .category-articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .category-articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    background-color: var(--color-qroo-mist);
    padding: 3rem 1.5rem;
    text-align: center;
    border-radius: var(--radius-md);
  }

  .btn-publish {
    display: inline-block;
    margin-top: 0.75rem;
    background-color: var(--color-qroo-navy);
    color: #ffffff;
    padding: 0.6rem 1.2rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.85rem;
  }
</style>
