---
import type { CollectionEntry } from 'astro:content';
import { optimizeCloudinaryUrl, formatEditorialDate } from '../utils/cloudinary';

interface Props {
  article: CollectionEntry<'noticias'>;
  variant?: 'default' | 'compact' | 'horizontal';
  isLcp?: boolean;
}

const { article, variant = 'default', isLcp = false } = Astro.props;
const { title, excerpt, category, image, author, pubDate } = article.data;
const categorySlug = category
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/\s+/g, '-');

const optimizedImg = optimizeCloudinaryUrl(image, {
  width: isLcp ? 1000 : 640,
  height: isLcp ? 562 : 360,
  crop: 'fill',
});
---

<article class:list={['news-card', `variant-${variant}`]}>
  {variant !== 'compact' && (
    <a href={`/noticias/${article.id}`} class="card-media-link" aria-label={title}>
      <div class="card-image-wrap">
        <img
          src={optimizedImg}
          alt={title}
          width={isLcp ? 1000 : 640}
          height={isLcp ? 562 : 360}
          fetchpriority={isLcp ? 'high' : undefined}
          loading={isLcp ? undefined : 'lazy'}
          class="card-img"
        />
      </div>
    </a>
  )}

  <div class="card-body">
    <a href={`/categoria/${categorySlug}`} class="badge-category">
      {category}
    </a>

    <h3 class={variant === 'compact' ? 'headline-compact' : 'headline-card'}>
      <a href={`/noticias/${article.id}`} class="card-title-link">
        {title}
      </a>
    </h3>

    {variant !== 'compact' && (
      <p class="editorial-excerpt">{excerpt}</p>
    )}

    <div class="card-meta">
      <span class="meta-author">{author}</span>
      <span class="meta-dot">·</span>
      <time datetime={pubDate.toISOString()}>{formatEditorialDate(pubDate)}</time>
    </div>
  </div>
</article>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--color-qroo-border);
  }

  .card-media-link {
    display: block;
    margin-bottom: 0.85rem;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--color-qroo-mist);
  }

  .card-image-wrap {
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .news-card:hover .card-img {
    transform: scale(1.03);
  }

  .card-title-link {
    color: var(--color-qroo-navy);
    transition: color 0.15s ease;
  }

  .card-title-link:hover {
    color: var(--color-qroo-cyan-dark);
  }

  .card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.76rem;
    color: var(--color-qroo-slate);
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .meta-author {
    font-weight: 700;
    color: var(--color-qroo-navy);
  }

  /* Horizontal Variant */
  .variant-horizontal {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .variant-horizontal {
      grid-template-columns: 220px 1fr;
      align-items: start;
    }
    .variant-horizontal .card-media-link {
      margin-bottom: 0;
    }
  }
</style>
